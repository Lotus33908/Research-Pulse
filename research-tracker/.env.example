# Copy to .env and fill in. Everything is free; nothing here costs money.

# Contact email sent with OpenAlex / Crossref requests (polite pool = faster, more reliable)
OPENALEX_MAILTO=

# Free OpenAlex API key (https://openalex.org -> Settings -> API). Strongly recommended: without it,
# everyone on the same network shares a small daily budget (about 100 author searches per day).
OPENALEX_API_KEY=

# Sources, comma separated. Options: openalex, orcid.  Google Scholar exports are imported from
# data/scholar_exports/*.bib automatically (profile -> select all -> Export -> BibTeX).
#SOURCES=openalex,orcid

# First publication year to keep (1900 = everything)
YEAR_FROM=1900

# Fuzzy journal-title match threshold (0-100). Higher = stricter. 100 disables fuzzy matching.
FUZZY_THRESHOLD=94

# Faculty categories to include, separated by ';'
#INCLUDE_CATEGORIES=Full-Time Faculty;Adjunct Faculty;Part-Time Faculty;Visiting Faculty
